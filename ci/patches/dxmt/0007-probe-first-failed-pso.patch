+/* Madeira iOS 16: one-shot probe after the first render PSO compile failure.
+ * The AGX error ("Compiler encountered an internal error") names nothing and
+ * each failing compile takes ~30 s, so this runs on a background queue:
+ *  1. runtime-compiled MSL vertex shaders that each use one feature airconv's
+ *     vertex shaders rely on,
+ *  2. offline-built variants of a failing airconv VS with one feature removed
+ *     each (pso_probe_data.h), compiled vertex-only,
+ *  3. a trivial MSL VS against the failing pipeline's fragment function.
+ * Each result is logged as [pso-probe] with its compile time. */
+#include "pso_probe_data.h"
+#include <dispatch/dispatch.h>
+#include <time.h>
+
+static void
+wmt_pso_probe_try(id<MTLDevice> device, MTLRenderPipelineDescriptor *d, const char *what) {
+  NSError *e = NULL;
+  struct timespec t0, t1;
+  clock_gettime(CLOCK_MONOTONIC, &t0);
+  id<MTLRenderPipelineState> pso = [device newRenderPipelineStateWithDescriptor:d error:&e];
+  clock_gettime(CLOCK_MONOTONIC, &t1);
+  double ms = (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6;
+  fprintf(stderr, "[pso-probe] %-26s %s (%.0f ms)%s%s\n", what, pso ? "OK  " : "FAIL", ms, pso ? "" : " ",
+          pso ? "" : (e ? [[e localizedDescription] UTF8String] : "(no error)"));
+  if (pso)
+    [pso release];
+}
+
+static void
+wmt_pso_probe(id<MTLDevice> device, MTLRenderPipelineDescriptor *failed) {
+  static int done;
+  if (done++)
+    return;
+  MTLPixelFormat fmt = failed.colorAttachments[0].pixelFormat;
+  if (fmt == MTLPixelFormatInvalid)
+    fmt = MTLPixelFormatBGRA8Unorm;
+  fprintf(stderr, "[pso-probe] begin (background): vs=%s fs=%s rt0=%lu\n",
+          failed.vertexFunction ? [failed.vertexFunction.name UTF8String] : "-",
+          failed.fragmentFunction ? [failed.fragmentFunction.name UTF8String] : "-", (unsigned long)fmt);
+  id<MTLFunction> failed_fs = [failed.fragmentFunction retain];
+  [device retain];
+  dispatch_async(dispatch_get_global_queue(QOS_CLASS_UTILITY, 0), ^{
+    @autoreleasepool {
+      NSString *src = @
+        "#include <metal_stdlib>\n"
+        "using namespace metal;\n"
+        "struct O { float4 p [[position]]; };\n"
+        "struct OI { float4 p [[position, invariant]]; };\n"
+        "struct AB { constant float4 *cb0; constant float4 *cb1; };\n"
+        "vertex O v_plain(uint vid [[vertex_id]]) { O o; o.p = float4(float(vid & 1), float(vid >> 1), 0, 1); return o; }\n"
+        "vertex OI v_inv(uint vid [[vertex_id]]) { OI o; o.p = float4(float(vid & 1), float(vid >> 1), 0, 1); return o; }\n"
+        "vertex O v_pull(uint vid [[vertex_id]], constant ulong *vb [[buffer(16)]]) {\n"
+        "  device packed_float3 *p = (device packed_float3 *)vb[0]; O o; o.p = float4(float3(p[vid]), 1); return o; }\n"
+        "vertex O v_argbuf(uint vid [[vertex_id]], constant AB &t [[buffer(29)]]) { O o; o.p = t.cb0[vid] * t.cb1[0]; return o; }\n"
+        "vertex O v_base(uint vid [[vertex_id]], uint bv [[base_vertex]], uint iid [[instance_id]], uint bi [[base_instance]]) {\n"
+        "  O o; o.p = float4(float(vid + bv), float(iid + bi), 0, 1); return o; }\n"
+        "fragment float4 f_zero() { return float4(0); }\n";
+      MTLCompileOptions *opts = [[MTLCompileOptions alloc] init];
+      opts.preserveInvariance = YES;
+      NSError *e = NULL;
+      id<MTLLibrary> lib = [device newLibraryWithSource:src options:opts error:&e];
+      [opts release];
+      id<MTLFunction> fzero = lib ? [lib newFunctionWithName:@"f_zero"] : nil;
+      if (!lib)
+        fprintf(stderr, "[pso-probe] MSL library FAIL %s\n", e ? [[e localizedDescription] UTF8String] : "");
+      const char *names[] = {"v_plain", "v_inv", "v_pull", "v_argbuf", "v_base"};
+      for (unsigned i = 0; lib && i < 5; i++) {
+        id<MTLFunction> vs = [lib newFunctionWithName:[NSString stringWithUTF8String:names[i]]];
+        MTLRenderPipelineDescriptor *m = [[MTLRenderPipelineDescriptor alloc] init];
+        m.colorAttachments[0].pixelFormat = fmt;
+        m.vertexFunction = vs;
+        m.fragmentFunction = fzero;
+        char what[64];
+        snprintf(what, sizeof what, "MSL %s", names[i]);
+        wmt_pso_probe_try(device, m, what);
+        [m release];
+        [vs release];
+      }
+      for (unsigned i = 0; i < sizeof(pso_probe_variants) / sizeof(pso_probe_variants[0]); i++) {
+        char what[64];
+        snprintf(what, sizeof what, "airconv VS -%s", pso_probe_variants[i].name);
+        dispatch_data_t data = dispatch_data_create(pso_probe_variants[i].data, pso_probe_variants[i].size, NULL,
+                                                    DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+        NSError *le = NULL;
+        id<MTLLibrary> vl = [device newLibraryWithData:data error:&le];
+        dispatch_release(data);
+        id<MTLFunction> vf = vl ? [vl newFunctionWithName:[NSString stringWithUTF8String:pso_probe_function]] : nil;
+        if (!vf) {
+          fprintf(stderr, "[pso-probe] %-26s NOLIB %s\n", what,
+                  le ? [[le localizedDescription] UTF8String] : "(no function)");
+        } else {
+          MTLRenderPipelineDescriptor *m = [[MTLRenderPipelineDescriptor alloc] init];
+          m.colorAttachments[0].pixelFormat = fmt;
+          m.vertexFunction = vf;
+          wmt_pso_probe_try(device, m, what);
+          [m release];
+        }
+        [vf release];
+        [vl release];
+      }
+      if (lib && failed_fs) {
+        id<MTLFunction> vplain = [lib newFunctionWithName:@"v_plain"];
+        MTLRenderPipelineDescriptor *m = [[MTLRenderPipelineDescriptor alloc] init];
+        m.colorAttachments[0].pixelFormat = fmt;
+        m.vertexFunction = vplain;
+        m.fragmentFunction = failed_fs;
+        wmt_pso_probe_try(device, m, "MSL v_plain + airconv FS");
+        [m release];
+        [vplain release];
+      }
+      [fzero release];
+      [lib release];
+      [failed_fs release];
+      [device release];
+      fprintf(stderr, "[pso-probe] end\n");
+    }
+  });
+}
