+/* poison -> undef, including inside constant vectors/structs/arrays. */
+static Constant *depoison(Constant *c) {
+  if (isa<PoisonValue>(c))
+    return UndefValue::get(c->getType());
+  if (!isa<ConstantVector>(c) && !isa<ConstantStruct>(c) && !isa<ConstantArray>(c))
+    return c;
+  SmallVector<Constant *, 16> ops;
+  bool changed = false;
+  for (unsigned i = 0; i < c->getNumOperands(); i++) {
+    auto *op = cast<Constant>(c->getOperand(i));
+    auto *n = depoison(op);
+    changed |= n != op;
+    ops.push_back(n);
+  }
+  if (!changed)
+    return c;
+  if (isa<ConstantVector>(c))
+    return ConstantVector::get(ops);
+  if (auto *st = dyn_cast<ConstantStruct>(c))
+    return ConstantStruct::get(st->getType(), ops);
+  return ConstantArray::get(cast<ConstantArray>(c)->getType(), ops);
+}
