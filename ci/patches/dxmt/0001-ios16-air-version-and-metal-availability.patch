@@ -397,6 +438,16 @@ void MetallibWriter::Write(const llvm::Module &module, raw_ostream &OS) {
   header.OS = OS::MTLBOS_macOS;
   header.OSVersionMajor = 14;
   header.OSVersionMinor = 4;
+  if (legacy) {
+    // iOS 16 also refuses a library whose header names macOS ("This library
+    // format is not supported on this platform"). These are the values Apple's
+    // own toolchain writes for -sdk iphoneos --target=air64-apple-ios16.0
+    // (platform 0x0001, OS 0x82, OS version 16.0), read off a library built so.
+    header.Platform = static_cast<Platform>(0x0001);
+    header.OS = static_cast<enum OS>(0x82);
+    header.OSVersionMajor = 16;
+    header.OSVersionMinor = 0;
+  }
 
   // write to stream
   OS << value(header);
